# ---- LLM provider: gemini | openrouter | mock (mock = offline, rule-based, no API key) ----
LLM_PROVIDER=gemini

# Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Free quotas are per model: when one runs out for the day, the agent moves to the next one
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.1-flash-lite

# OpenRouter (free key: https://openrouter.ai/keys). "openrouter/free" routes to any currently available free model
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free

# ---- Email backend: mock | gmail ----
EMAIL_BACKEND=mock
# Only needed for EMAIL_BACKEND=gmail (use a Google "App password", not your real password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ---- Agent behaviour ----
AUTO_SEND=true            # false = every reply goes to the human review queue instead of being sent
MAX_TOOL_STEPS=6          # max tool-calling iterations per email
MIN_PLAN_CONFIDENCE=0.5   # below this the email is escalated to a human
SUPPORT_ADDRESS=support@nimbus-electronics.example
